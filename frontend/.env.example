# Prazno = koristi Vite proxy iz vite.config.js (razvoj, servisi direktno).
# Kad API Gateway proradi, stavi: VITE_API_URL=/api
VITE_API_URL=

# MinIO adresa dostupna iz pregledaca. Backend vraca internu docker adresu
# (http://minio:9000/...), koju frontend prepisuje na ovu.
VITE_MEDIA_URL=http://localhost:9000
