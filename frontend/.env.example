# Prazno = koristi Vite proxy iz vite.config.js i salje zahteve na API Gateway.
# Ako zelis direktan browser pristup gateway-ju, stavi: VITE_API_URL=http://localhost:8080
VITE_API_URL=

# MinIO adresa dostupna iz pregledaca. Backend vraca internu docker adresu
# (http://minio:9000/...), koju frontend prepisuje na ovu.
VITE_MEDIA_URL=http://localhost:9000
